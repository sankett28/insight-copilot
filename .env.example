# Insight Copilot — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# ── LLM Providers ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash   # optional: override default Gemini model

GROQ_API_KEY=your-groq-api-key-here   # optional: enables Groq fallback when Gemini hits rate limits
GROQ_MODEL=openai/gpt-oss-120b    # optional: override default Groq model

LLM_PROVIDER=gemini             # gemini (with automatic Groq fallback if GROQ_API_KEY is set) or groq

# ── Data ──────────────────────────────────────────────────────────────────
DATASET_PATH=data/Sales_Dataset_2024.xlsx   # canonical enterprise sales dataset

# ── App ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
