# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
.env

# Secrets — NEVER commit real env files
.env.local
.env.*.local

# Pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# DuckDB temp files
*.duckdb
*.duckdb.wal

# Data files (may be large or contain PII)
data/*.csv
data/*.parquet
data/*.xlsx
data/*.xls
!data/.gitkeep
!data/README.md

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Distribution / packaging
dist/
build/
*.egg-info/
