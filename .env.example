# Insight Copilot — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash   # optional: override the default model

LLM_PROVIDER=gemini             # currently the only supported provider


# ── Data ──────────────────────────────────────────────────────────────────
DATASET_PATH=data/your_dataset.csv    # relative or absolute path to dataset

# ── App ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
